# Copy to .env and fill in. Do not commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# SQLite database file (created on first run).
DB_PATH=data/app.db

# Session signing secret. REQUIRED in production (>= 16 chars).
# Dev falls back to an insecure default if unset.
JWT_SECRET=change-me-to-a-long-random-string

# Encryption key for stored app configs. REQUIRED in production (>= 16 chars).
# Dev falls back to an insecure default if unset.
APP_CONFIG_KEY=change-me-to-another-long-random-string
