---
import { MessageCircle } from '@lucide/astro';
import { site, nav } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-12 md:flex-row md:items-center md:justify-between"
  >
    <a href="/" class="flex items-center gap-2 font-semibold text-ink">
      <MessageCircle class="size-5 text-accent" />
      {site.name}
    </a>

    <nav class="flex flex-wrap gap-6">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <p class="text-sm text-muted">
      &copy; {year} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
