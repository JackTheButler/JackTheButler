---
import { site, nav } from '../config/site';
import janeLogo from '../icons/jane.svg?raw';
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-surface/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a
      href="/"
      class="flex items-center gap-2 font-semibold text-ink [&_svg]:h-7 [&_svg]:w-auto"
    >
      <span class="text-ink" aria-hidden="true" set:html={janeLogo} />
      {site.name}
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={site.ctaHref}
      class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
    >
      {site.ctaLabel}
    </a>
  </div>
</header>
