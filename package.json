{
  "name": "jane-the-operator",
  "version": "0.4.0",
  "description": "Jane the Operator: an AI customer-support agent with webchat, a knowledge base, and a human-handoff team inbox.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:dashboard": "pnpm --filter @janetheoperator/dashboard dev",
    "dev:website": "pnpm --filter @janetheoperator/landing dev",
    "dev:ui": "pnpm --filter @janetheoperator/widget-ui exec tsc --watch --preserveWatchOutput",
    "build": "pnpm --filter './packages/*' build && tsc && tsc-alias",
    "build:ui": "pnpm --filter @janetheoperator/widget-ui build",
    "build:dashboard": "pnpm build:ui && pnpm --filter @janetheoperator/dashboard build",
    "preview:dashboard": "pnpm build:dashboard && pnpm --filter @janetheoperator/dashboard preview",
    "build:website": "pnpm --filter @janetheoperator/landing build",
    "build:widget": "pnpm build:ui && pnpm --filter @janetheoperator/widget build",
    "build:all": "pnpm build && pnpm build:widget && pnpm build:dashboard",
    "deploy:website": "pnpm build:website && pnpm dlx wrangler pages deploy apps/landing/dist --project-name=janetheoperator-landing --branch=main --commit-dirty=true",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "pnpm --filter './packages/*' build && tsc --noEmit && pnpm --filter @janetheoperator/dashboard typecheck && pnpm --filter @janetheoperator/widget typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^0.15.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.3.1",
    "@janetheoperator/ai-anthropic": "workspace:*",
    "@janetheoperator/ai-openai-embedding": "workspace:*",
    "@janetheoperator/channel-webchat": "workspace:*",
    "@janetheoperator/shared": "workspace:*",
    "@thebutler/pipeline": "^0.1.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.7",
    "jose": "^6.2.3",
    "pino": "^10.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.1",
    "zod": "^4.3.6"
  }
}
